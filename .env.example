EVIDENCEOPS_DATABASE_URL=postgresql+psycopg://evidenceops:evidenceops-local@localhost:5432/evidenceops
EVIDENCEOPS_TEST_DATABASE_URL=postgresql+psycopg://evidenceops:evidenceops-local@localhost:5432/evidenceops_test
EVIDENCEOPS_LLM_PROVIDER=gemini
EVIDENCEOPS_GEMINI_API_KEY=
EVIDENCEOPS_GEMINI_MODEL=gemini-3.6-flash
EVIDENCEOPS_GEMINI_MAX_OUTPUT_TOKENS=2048
EVIDENCEOPS_GEMINI_TIMEOUT_SECONDS=60
EVIDENCEOPS_DEEPSEEK_API_KEY=
EVIDENCEOPS_DEEPSEEK_MODEL=deepseek-flash
EVIDENCEOPS_DEEPSEEK_MAX_OUTPUT_TOKENS=2048
EVIDENCEOPS_DEEPSEEK_TIMEOUT_SECONDS=60
EVIDENCEOPS_TRACE_CONSOLE=false
# Required by the API: comma-separated keys, at least 16 characters each (M11.2, D037)
EVIDENCEOPS_API_KEYS=
EVIDENCEOPS_RATE_LIMIT_CAPACITY=5
EVIDENCEOPS_RATE_LIMIT_REFILL_PER_SECOND=0.1
EVIDENCEOPS_LLM_TOTAL_TIMEOUT_SECONDS=90
EVIDENCEOPS_DATABASE_CONNECT_TIMEOUT_SECONDS=5
EVIDENCEOPS_DATABASE_STATEMENT_TIMEOUT_MS=30000
EVIDENCEOPS_PUBMED_API_KEY=
EVIDENCEOPS_PUBMED_EMAIL=
EVIDENCEOPS_PUBMED_TOOL=EvidenceOps
EVIDENCEOPS_PUBMED_TIMEOUT_SECONDS=15

# Async ingestion queue and worker (M11.1, D036)
EVIDENCEOPS_JOBS_MAX_ATTEMPTS=3
EVIDENCEOPS_JOBS_BACKOFF_BASE_SECONDS=10
EVIDENCEOPS_JOBS_BACKOFF_MAX_SECONDS=300
EVIDENCEOPS_JOBS_LEASE_SECONDS=300
EVIDENCEOPS_JOBS_POLL_SECONDS=2
EVIDENCEOPS_JOBS_POLL_BACKOFF_MAX_SECONDS=60

# RAG retrieval: semantic (default), hybrid (BM25 + MedCPT), reranking (MedCPT top20 -> Cross-Encoder top5)
EVIDENCEOPS_RETRIEVAL_MODE=semantic
